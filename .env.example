PORT=3000

# Where hotel records are stored:
#   db   - PostgreSQL (configure the PG* settings below, then run `npm run db:init`)
#   json - a JSON file on disk (no database needed)
MODE=db
# MODE=json

# JSON data file used when MODE=json (relative to the Service folder)
JSON_DATA_FILE=data/hotels.json

# Allowed browser origins for CORS (comma-separated, or * for any)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=hotel_list
PG_POOL_MAX=10

# Max image upload size in megabytes
MAX_IMAGE_SIZE_MB=5
